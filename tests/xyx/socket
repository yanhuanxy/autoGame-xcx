 (function() {
      const logs = [];
      window._wsLogs = logs;

      const OrigWS = window.WebSocket;
      function toHex(buf) {
          return Array.from(new Uint8Array(buf))
              .map(b => b.toString(16).padStart(2, '0')).join(' ');
      }

      window.WebSocket = function(url, protocols) {
          console.log('[WS] connect:', url);
          const ws = protocols ? new OrigWS(url, protocols) : new OrigWS(url);

          const origSend = ws.send.bind(ws);
          ws.send = function(data) {
              const e = { dir: 'OUT', ts: Date.now() };
              if (typeof data === 'string') { e.type = 'text'; e.text = data; }
              else if (data instanceof ArrayBuffer) { e.type = 'bin'; e.hex = toHex(data); }
              else if (data instanceof Blob) { e.type = 'blob'; data.arrayBuffer().then(ab => e.hex = toHex(ab)); }
              logs.push(e);
              return origSend(data);
          };

          ws.addEventListener('message', function(ev) {
              const e = { dir: 'IN', ts: Date.now() };
              if (typeof ev.data === 'string') { e.type = 'text'; e.text = ev.data; }
              else if (ev.data instanceof ArrayBuffer) { e.type = 'bin'; e.hex = toHex(ev.data); }
              else if (ev.data instanceof Blob) { e.type = 'blob'; ev.data.arrayBuffer().then(ab => e.hex = toHex(ab)); }
              logs.push(e);
          });

          return ws;
      };
      window.WebSocket.prototype = OrigWS.prototype;
      window.WebSocket.CONNECTING = OrigWS.CONNECTING;
      window.WebSocket.OPEN = OrigWS.OPEN;
      window.WebSocket.CLOSING = OrigWS.CLOSING;
      window.WebSocket.CLOSED = OrigWS.CLOSED;

      // 一键导出
      window.dumpWs = () => JSON.stringify(logs, null, 2);
      window.clearWs = () => { logs.length = 0; console.log('[WS] cleared'); };
      console.log('[WS] hook installed. dumpWs() to export, clearWs() to clear');
  })();

